# Copy to .env (git-ignored). Defaults run everything locally with no AWS account.

# --- Airflow ---------------------------------------------------------------
# Linux: set to the output of `id -u` so containers can write to ./data_lake and ./dbt
AIRFLOW_UID=50000

# --- What to ingest ------------------------------------------------------------
# competition_id:season_id pairs (43:3 = FIFA World Cup 2018). See competitions.json.
STATSBOMB_COMPETITIONS=43:3
# STATSBOMB_MAX_MATCHES=10

# --- Mode 1: fully local (default) ---------------------------------------------
LAKE_ROOT=/opt/airflow/data_lake
SPARK_RUNNER=local
DBT_TARGET=duckdb

# --- Mode 2: AWS (paste `terraform output -raw dotenv` over the block above) -----
# AWS_DEFAULT_REGION=eu-west-2
# S3_BUCKET_NAME=statsbomb-dev-lake-123456789012
# LAKE_ROOT=s3://statsbomb-dev-lake-123456789012
# SPARK_RUNNER=glue                # or `local` to run Spark in the Airflow container
# GLUE_JOB_NAME=statsbomb-dev-statsbomb-transform
# DBT_TARGET=athena
# DBT_SCHEMA_PREFIX=statsbomb_dev
# ATHENA_WORKGROUP=statsbomb-dev
# ATHENA_S3_STAGING_DIR=s3://statsbomb-dev-athena-results-123456789012/query-results/
# ATHENA_S3_DATA_DIR=s3://statsbomb-dev-lake-123456789012/dbt/

# Credentials: prefer an AWS profile / SSO or assuming the Terraform `pipeline_role_arn`.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
