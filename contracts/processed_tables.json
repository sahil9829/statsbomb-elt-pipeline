{
  "_comment": "Schema contract for the processed zone. Terraform registers these as Glue Catalog tables; the PySpark test-suite asserts the job output matches column-for-column. Types are Hive/Glue type names.",
  "tables": {
    "competitions": {
      "description": "One row per competition-season available in StatsBomb open data.",
      "columns": [
        {"name": "competition_id", "type": "bigint"},
        {"name": "season_id", "type": "bigint"},
        {"name": "competition_name", "type": "string"},
        {"name": "country_name", "type": "string"},
        {"name": "competition_gender", "type": "string"},
        {"name": "competition_youth", "type": "boolean"},
        {"name": "competition_international", "type": "boolean"},
        {"name": "season_name", "type": "string"},
        {"name": "match_updated_at", "type": "timestamp"},
        {"name": "match_available_at", "type": "timestamp"},
        {"name": "_ingested_at", "type": "timestamp"}
      ]
    },
    "matches": {
      "description": "One row per match, nested team/stadium/referee structs flattened.",
      "columns": [
        {"name": "match_id", "type": "bigint"},
        {"name": "match_date", "type": "date"},
        {"name": "kick_off", "type": "string"},
        {"name": "competition_id", "type": "bigint"},
        {"name": "competition_name", "type": "string"},
        {"name": "season_id", "type": "bigint"},
        {"name": "season_name", "type": "string"},
        {"name": "home_team_id", "type": "bigint"},
        {"name": "home_team_name", "type": "string"},
        {"name": "home_team_gender", "type": "string"},
        {"name": "home_team_country_name", "type": "string"},
        {"name": "home_manager_name", "type": "string"},
        {"name": "away_team_id", "type": "bigint"},
        {"name": "away_team_name", "type": "string"},
        {"name": "away_team_gender", "type": "string"},
        {"name": "away_team_country_name", "type": "string"},
        {"name": "away_manager_name", "type": "string"},
        {"name": "home_score", "type": "int"},
        {"name": "away_score", "type": "int"},
        {"name": "match_status", "type": "string"},
        {"name": "match_week", "type": "int"},
        {"name": "competition_stage_id", "type": "bigint"},
        {"name": "competition_stage_name", "type": "string"},
        {"name": "stadium_id", "type": "bigint"},
        {"name": "stadium_name", "type": "string"},
        {"name": "stadium_country_name", "type": "string"},
        {"name": "referee_id", "type": "bigint"},
        {"name": "referee_name", "type": "string"},
        {"name": "referee_country_name", "type": "string"},
        {"name": "data_version", "type": "string"},
        {"name": "last_updated_at", "type": "timestamp"},
        {"name": "_ingested_at", "type": "timestamp"}
      ]
    },
    "events": {
      "description": "One row per match event with the type-specific sub-objects (pass, shot, carry, ...) flattened into prefixed columns.",
      "columns": [
        {"name": "event_id", "type": "string"},
        {"name": "match_id", "type": "bigint"},
        {"name": "event_index", "type": "int"},
        {"name": "period", "type": "int"},
        {"name": "event_timestamp", "type": "string"},
        {"name": "minute", "type": "int"},
        {"name": "second", "type": "int"},
        {"name": "type_id", "type": "bigint"},
        {"name": "type_name", "type": "string"},
        {"name": "possession", "type": "int"},
        {"name": "possession_team_id", "type": "bigint"},
        {"name": "play_pattern_id", "type": "bigint"},
        {"name": "play_pattern_name", "type": "string"},
        {"name": "team_id", "type": "bigint"},
        {"name": "team_name", "type": "string"},
        {"name": "player_id", "type": "bigint"},
        {"name": "player_name", "type": "string"},
        {"name": "position_id", "type": "bigint"},
        {"name": "position_name", "type": "string"},
        {"name": "location_x", "type": "double"},
        {"name": "location_y", "type": "double"},
        {"name": "duration", "type": "double"},
        {"name": "under_pressure", "type": "boolean"},
        {"name": "counterpress", "type": "boolean"},
        {"name": "pass_recipient_id", "type": "bigint"},
        {"name": "pass_length", "type": "double"},
        {"name": "pass_angle", "type": "double"},
        {"name": "pass_height_name", "type": "string"},
        {"name": "pass_end_location_x", "type": "double"},
        {"name": "pass_end_location_y", "type": "double"},
        {"name": "pass_type_name", "type": "string"},
        {"name": "pass_body_part_name", "type": "string"},
        {"name": "pass_outcome_name", "type": "string"},
        {"name": "pass_is_cross", "type": "boolean"},
        {"name": "pass_is_shot_assist", "type": "boolean"},
        {"name": "pass_is_goal_assist", "type": "boolean"},
        {"name": "carry_end_location_x", "type": "double"},
        {"name": "carry_end_location_y", "type": "double"},
        {"name": "shot_statsbomb_xg", "type": "double"},
        {"name": "shot_outcome_name", "type": "string"},
        {"name": "shot_type_name", "type": "string"},
        {"name": "shot_body_part_name", "type": "string"},
        {"name": "shot_technique_name", "type": "string"},
        {"name": "shot_end_location_x", "type": "double"},
        {"name": "shot_end_location_y", "type": "double"},
        {"name": "shot_end_location_z", "type": "double"},
        {"name": "shot_key_pass_id", "type": "string"},
        {"name": "shot_first_time", "type": "boolean"},
        {"name": "dribble_outcome_name", "type": "string"},
        {"name": "duel_type_name", "type": "string"},
        {"name": "duel_outcome_name", "type": "string"},
        {"name": "interception_outcome_name", "type": "string"},
        {"name": "goalkeeper_type_name", "type": "string"},
        {"name": "goalkeeper_outcome_name", "type": "string"},
        {"name": "foul_committed_card_name", "type": "string"},
        {"name": "bad_behaviour_card_name", "type": "string"},
        {"name": "substitution_replacement_id", "type": "bigint"},
        {"name": "substitution_outcome_name", "type": "string"},
        {"name": "tactics_formation", "type": "int"},
        {"name": "_ingested_at", "type": "timestamp"}
      ]
    },
    "lineups": {
      "description": "One row per player per team per match (squad list), including bench players who did not appear.",
      "columns": [
        {"name": "match_id", "type": "bigint"},
        {"name": "team_id", "type": "bigint"},
        {"name": "team_name", "type": "string"},
        {"name": "player_id", "type": "bigint"},
        {"name": "player_name", "type": "string"},
        {"name": "player_nickname", "type": "string"},
        {"name": "jersey_number", "type": "int"},
        {"name": "country_id", "type": "bigint"},
        {"name": "country_name", "type": "string"},
        {"name": "appeared", "type": "boolean"},
        {"name": "is_starter", "type": "boolean"},
        {"name": "first_position_id", "type": "bigint"},
        {"name": "first_position_name", "type": "string"},
        {"name": "on_minute", "type": "double"},
        {"name": "on_period", "type": "int"},
        {"name": "off_minute", "type": "double"},
        {"name": "off_period", "type": "int"},
        {"name": "off_reason", "type": "string"},
        {"name": "yellow_cards", "type": "int"},
        {"name": "red_cards", "type": "int"},
        {"name": "_ingested_at", "type": "timestamp"}
      ]
    }
  }
}
